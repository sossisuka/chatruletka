# Local preview: npm run dev -- --port 3005
PORT=3005
BIND_HOST=0.0.0.0
# Empty: allow browser connections from the same host (localhost, LAN, public IP, HTTPS).
# Optional strict allowlist: https://chat.example.com,http://localhost:3005
APP_ORIGIN=
# Extra IPs/hostnames allowed to use Next.js development HMR (no scheme or port).
DEV_ALLOWED_ORIGINS=185.128.200.106
MAX_CONNECTIONS_PER_IP=30

# 2ip Geo API token: https://2ip.io/ru/api-token/ (server-only, no NEXT_PUBLIC_ prefix).
TWOIP_API_TOKEN=
# true only behind one local nginx/Caddy proxy that appends/overwrites X-Forwarded-For.
# Docker defaults to true; keep its app port bound to 127.0.0.1.
TRUST_PROXY=false

# Google Search Console HTML file verification.
# Example: GOOGLE_SITE_VERIFICATION_FILE=google123abc.html
# Content is optional; by default it returns "google-site-verification: <file>".
GOOGLE_SITE_VERIFICATION_FILE=
GOOGLE_SITE_VERIFICATION_CONTENT=

# Telegram bot webhook (server-only). Never commit the real bot token.
TELEGRAM_BOT_TOKEN=
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SITE_URL=https://videochatik.online/

# Optional TURN relay, needed for reliable calling across restrictive NAT/firewalls.
# Coturn REST authentication: the shared secret remains on the server.
TURN_URLS=
TURN_SECRET=
# Example: TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp

# Docker Compose public / turn profiles:
DOMAIN=localhost
TURN_PUBLIC_IP=
TURN_REALM=chatruletka
